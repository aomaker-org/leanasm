import LeanAsm.GSp4FunctorialityBridge
import LeanAsm.LanglandsRankinSelbergBridge

namespace SatakeHeckeDegreeBridge

/-!
# Satake Spherical Hecke Degree Bridge

Distills spherical Hecke operator double coset cardinalities and degrees
from adelic Iwasawa-Hecke theory (as in `alpo-rh`'s `Satake.lean` and `SatakeComb.lean`)
into constructive polynomial and q-binomial evaluations over `Int` and `Nat` without
measure theory, under zero Mathlib and zero `Classical.choice`.

For $\mathrm{GL}_n$, the degree of the spherical Hecke generator $T_j$ satisfies:
$$\deg(T_j) = q^{j(n-j)/2} [n \text{ choose } j]_q$$
where $[n \text{ choose } j]_q = \frac{\prod_{i=0}^{j-1}(q^{n-i}-1)}{\prod_{i=0}^{j-1}(q^{i+1}-1)}$.
In particular:
- For $n=2, j=1$: $\deg(T_1) = 1 + q$.
- For $n=3, j=1$: $\deg(T_1) = 1 + q + q^2$.
- For $n=4, j=1$: $\deg(T_1) = 1 + q + q^2 + q^3$.
- For $n=4, j=2$: $[4 \text{ choose } 2]_q = (1+q^2)(1+q+q^2) = 1 + q + 2q^2 + q^3 + q^4$.

For $\mathrm{GSp}_4$, the spherical Hecke algebra is generated by $T(p)$ (similitude $p$)
and $T(p^2)$ (or $T_1 = T(\operatorname{diag}(1,1,p,p))$ and $T_2 = T(\operatorname{diag}(1,p,p,p^2))$):
- Degree of $T(\operatorname{diag}(1,1,p,p))$ is $p^3 + p^2 + p + 1 = (p+1)(p^2+1)$.
- Degree of $T(\operatorname{diag}(1,p,p,p^2))$ is $p^4 + p^3 + p^2 + p = p(p+1)(p^2+1)$.
-/

private theorem q_pow2 (q : Int) : q ^ 2 = q * q := by
  simp only [Int.pow_succ, Int.pow_zero, Int.one_mul]

private theorem q_pow3 (q : Int) : q ^ 3 = q * q * q := by
  simp only [Int.pow_succ, Int.pow_zero, Int.one_mul, Int.mul_assoc]

private theorem q_pow4 (q : Int) : q ^ 4 = q * q * q * q := by
  simp only [Int.pow_succ, Int.pow_zero, Int.one_mul, Int.mul_assoc]

/-- Constructive q-binomial polynomial $[n \text{ choose } 1]_q = \sum_{i=0}^{n-1} q^i$ over `Int`. -/
def qBinom1 (n : Nat) (q : Int) : Int :=
  match n with
  | 0 => 0
  | n + 1 => qBinom1 n q * q + 1

/-- Constructive q-binomial $[n \text{ choose } 1]_q$ over `Nat`. -/
def qBinom1Nat (n : Nat) (q : Nat) : Nat :=
  match n with
  | 0 => 0
  | n + 1 => qBinom1Nat n q * q + 1

/-- Identity relating `qBinom1` and `q - 1`: `(q - 1) * [n choose 1]_q = q^n - 1`. -/
theorem qBinom1_mul_sub_one (n : Nat) (q : Int) :
    (q - 1) * qBinom1 n q = q ^ n - 1 := by
  induction n with
  | zero =>
    simp [qBinom1, Int.pow_zero]
  | succ k ih =>
    simp only [qBinom1, Int.pow_succ]
    calc (q - 1) * (qBinom1 k q * q + 1)
      _ = (q - 1) * (qBinom1 k q * q) + (q - 1) * 1 := by rw [Int.mul_add]
      _ = ((q - 1) * qBinom1 k q) * q + (q - 1) := by rw [← Int.mul_assoc, Int.mul_one]
      _ = (q ^ k - 1) * q + (q - 1) := by rw [ih]
      _ = (q ^ k * q - 1 * q) + (q - 1) := by rw [Int.sub_mul]
      _ = q ^ k * q - 1 := by
        have : (1 : Int) * q = q := Int.one_mul q
        rw [this]
        omega

/-- The degree of $\mathrm{GL}_2$ spherical Hecke operator $T_1$: $\deg(T_1) = 1 + q$. -/
def degGL2T1 (q : Int) : Int :=
  q + 1

theorem degGL2T1_eq_qBinom1 (q : Int) :
    degGL2T1 q = qBinom1 2 q := by
  dsimp [degGL2T1, qBinom1]
  simp only [Int.zero_mul, Int.zero_add, Int.one_mul]

/-- The degree of $\mathrm{GL}_n$ spherical Hecke generator $T_1$: $\deg(T_1) = [n \text{ choose } 1]_q$. -/
def degGLnT1 (n : Nat) (q : Int) : Int :=
  qBinom1 n q

/-- Explicit degree evaluation for $n = 3$: $\deg(T_1) = 1 + q + q^2$. -/
theorem degGL3T1_eval (q : Int) :
    degGLnT1 3 q = q ^ 2 + q + 1 := by
  dsimp [degGLnT1, qBinom1]
  simp only [Int.zero_mul, Int.zero_add, Int.add_mul, Int.one_mul, Int.pow_succ, Int.pow_zero]

/-- Explicit degree evaluation for $n = 4$: $\deg(T_1) = 1 + q + q^2 + q^3$. -/
theorem degGL4T1_eval (q : Int) :
    degGLnT1 4 q = q ^ 3 + q ^ 2 + q + 1 := by
  dsimp [degGLnT1, qBinom1]
  simp only [Int.zero_mul, Int.zero_add, Int.add_mul, Int.one_mul, Int.pow_succ, Int.pow_zero, Int.mul_assoc]

/-- The q-binomial $[4 \text{ choose } 2]_q = (q^2 + 1)(q^2 + q + 1)$ over `Int`. -/
def qBinom4_2 (q : Int) : Int :=
  (q ^ 2 + 1) * (q ^ 2 + q + 1)

/-- Expansion of $[4 \text{ choose } 2]_q = q^4 + q^3 + 2q^2 + q + 1$. -/
theorem qBinom4_2_expanded (q : Int) :
    qBinom4_2 q = q ^ 4 + q ^ 3 + 2 * q ^ 2 + q + 1 := by
  dsimp [qBinom4_2]
  simp only [q_pow2, q_pow3, q_pow4]
  have hd : (q * q + 1) * (q * q + q + 1) = (q * q) * (q * q + q + 1) + 1 * (q * q + q + 1) := by
    rw [Int.add_mul]
  have h2 : (2 : Int) = 1 + 1 := rfl
  calc (q * q + 1) * (q * q + q + 1)
    _ = (q * q) * (q * q + q + 1) + 1 * (q * q + q + 1) := hd
    _ = (q * q * (q * q) + q * q * q + q * q * 1) + (q * q + q + 1) := by
      simp only [Int.mul_add, Int.one_mul]
    _ = (q * q * q * q + q * q * q + q * q) + (q * q + q + 1) := by
      simp only [Int.mul_one, Int.mul_assoc]
    _ = q * q * q * q + q * q * q + (1 + 1) * (q * q) + q + 1 := by
      simp only [Int.add_mul, Int.one_mul]
      omega
    _ = q * q * q * q + q * q * q + 2 * (q * q) + q + 1 := by rw [← h2]

/-- Product relation for $[4 \text{ choose } 2]_q$:
`(q - 1)(q^2 - 1) * [4 choose 2]_q = (q^4 - 1)(q^3 - 1)`. -/
theorem qBinom4_2_identity (q : Int) :
    (q - 1) * (q ^ 2 - 1) * qBinom4_2 q = (q ^ 4 - 1) * (q ^ 3 - 1) := by
  dsimp [qBinom4_2]
  simp only [q_pow2, q_pow3, q_pow4]
  have h1 : (q - 1) * (q * q + q + 1) = q * q * q - 1 := by
    calc (q - 1) * (q * q + q + 1)
      _ = q * (q * q + q + 1) - 1 * (q * q + q + 1) := by rw [Int.sub_mul]
      _ = (q * (q * q) + q * q + q * 1) - (q * q + q + 1) := by
        simp only [Int.mul_add, Int.one_mul]
      _ = q * q * q - 1 := by
        simp only [Int.mul_one, Int.mul_assoc]
        omega
  have h2 : (q * q - 1) * (q * q + 1) = q * q * q * q - 1 := by
    calc (q * q - 1) * (q * q + 1)
      _ = (q * q) * (q * q + 1) - 1 * (q * q + 1) := by rw [Int.sub_mul]
      _ = ((q * q) * (q * q) + (q * q) * 1) - (q * q + 1) := by
        simp only [Int.mul_add, Int.one_mul]
      _ = q * q * q * q - 1 := by
        simp only [Int.mul_one, Int.mul_assoc]
        omega
  calc (q - 1) * (q * q - 1) * ((q * q + 1) * (q * q + q + 1))
    _ = ((q * q - 1) * (q * q + 1)) * ((q - 1) * (q * q + q + 1)) := by
      ac_rfl
    _ = (q * q * q * q - 1) * (q * q * q - 1) := by rw [h2, h1]

/-- Spherical Hecke degree polynomial for $T_2$ on $\mathrm{GL}_4$:
$\deg(T_2) = q^2 [4 \text{ choose } 2]_q = q^2 (q^2 + 1)(q^2 + q + 1)$. -/
def degGL4T2 (q : Int) : Int :=
  q ^ 2 * qBinom4_2 q

theorem degGL4T2_identity (q : Int) :
    (q - 1) * (q ^ 2 - 1) * degGL4T2 q = q ^ 2 * ((q ^ 4 - 1) * (q ^ 3 - 1)) := by
  dsimp [degGL4T2]
  have hcomm : (q - 1) * (q ^ 2 - 1) * (q ^ 2 * qBinom4_2 q) =
      q ^ 2 * ((q - 1) * (q ^ 2 - 1) * qBinom4_2 q) := by
    rw [← Int.mul_assoc, Int.mul_comm ((q - 1) * (q ^ 2 - 1)) (q ^ 2), Int.mul_assoc]
  rw [hcomm, qBinom4_2_identity]

/-! ## GSp(4) Spherical Hecke Coset Cardinalities -/

/-- Spherical double coset degree for $\mathrm{GSp}_4$ generator $T_{1,0} = K \operatorname{diag}(1,1,p,p) K$:
Degree is $(p + 1)(p^2 + 1) = p^3 + p^2 + p + 1$. -/
def gsp4HeckeDegT1 (p : Int) : Int :=
  (p + 1) * (p ^ 2 + 1)

/-- Spherical double coset degree for $\mathrm{GSp}_4$ generator $T_{0,1} = K \operatorname{diag}(1,p,p,p^2) K$:
Degree is $p (p + 1) (p^2 + 1) = p^4 + p^3 + p^2 + p$. -/
def gsp4HeckeDegT2 (p : Int) : Int :=
  p * (p + 1) * (p ^ 2 + 1)

/-- Full degree polynomial of the spherical Hecke operator $T(p)$ on $\mathrm{GSp}_4$:
Degree is $p^3 + p^2 + p + 1$. -/
theorem gsp4HeckeDegT1_eval (p : Int) :
    gsp4HeckeDegT1 p = p ^ 3 + p ^ 2 + p + 1 := by
  dsimp [gsp4HeckeDegT1]
  simp only [Int.add_mul, Int.mul_add, Int.one_mul, Int.mul_one,
    Int.pow_succ, Int.pow_zero, Int.mul_assoc]
  omega

theorem gsp4HeckeDegT2_eval (p : Int) :
    gsp4HeckeDegT2 p = p ^ 4 + p ^ 3 + p ^ 2 + p := by
  dsimp [gsp4HeckeDegT2]
  simp only [Int.add_mul, Int.mul_add, Int.one_mul, Int.mul_one,
    Int.pow_succ, Int.pow_zero, Int.mul_assoc]
  omega

/-- Compatibility between $\mathrm{GSp}_4$ spherical Hecke degree and $\mathrm{GL}_4$ $T_1$ degree:
$\deg(T_{1, \mathrm{GSp}_4}) = \deg(T_{1, \mathrm{GL}_4}) = 1 + p + p^2 + p^3$. -/
theorem gsp4_degT1_eq_gl4_degT1 (p : Int) :
    gsp4HeckeDegT1 p = degGLnT1 4 p := by
  rw [gsp4HeckeDegT1_eval, degGL4T1_eval]

/-- Multi-prime concrete evaluation of $\mathrm{GSp}_4$ spherical Hecke degrees for $p \in \{2, 3, 5, 7, 11\}$. -/
theorem gsp4_degT1_concrete :
    gsp4HeckeDegT1 2 = 15 ∧
    gsp4HeckeDegT1 3 = 40 ∧
    gsp4HeckeDegT1 5 = 156 ∧
    gsp4HeckeDegT1 7 = 400 ∧
    gsp4HeckeDegT1 11 = 1464 := by
  decide

theorem gsp4_degT2_concrete :
    gsp4HeckeDegT2 2 = 30 ∧
    gsp4HeckeDegT2 3 = 120 ∧
    gsp4HeckeDegT2 5 = 780 ∧
    gsp4HeckeDegT2 7 = 2800 ∧
    gsp4HeckeDegT2 11 = 16104 := by
  decide

/-! ## Satake Inversion Polynomial & Compatibility with GSp4FunctorialityBridge -/

/-- Inversion polynomial evaluation: For $S \subset \{0, \dots, n-1\}$, the Satake factor
is governed by $q^{\operatorname{inv}(S)}$ where $\operatorname{inv}$ matches the combinatorial
exponents in `SatakeComb.lean`. For $n=2$, the coset weights are $q^0$ and $q^1$.
Their sum is $1 + q = \deg(T_1)$. -/
theorem satake_gl2_inv_sum (q : Int) :
    1 + q = degGL2T1 q := by
  dsimp [degGL2T1]
  omega

/-- For $n=3$, the coset weights for singletons are $q^0, q^1, q^2$, summing to $1 + q + q^2 = \deg(T_1)$. -/
theorem satake_gl3_inv_sum (q : Int) :
    1 + q + q ^ 2 = degGLnT1 3 q := by
  rw [degGL3T1_eval]
  omega

/-- For $n=4$, the singleton weights are $q^0, q^1, q^2, q^3$, summing to $\deg(T_1)$. -/
theorem satake_gl4_inv_sum (q : Int) :
    1 + q + q ^ 2 + q ^ 3 = degGLnT1 4 q := by
  rw [degGL4T1_eval]
  omega

/-- Bundled Satake-Hecke degree bridge specification. -/
structure SatakeHeckeDegreeSpec where
  q : Int
  hq : 2 ≤ q

/-- Master bridge certificate connecting Satake spherical Hecke degrees,
$q$-binomial evaluations, and $\mathrm{GSp}_4$ functorial degrees. -/
theorem satake_hecke_degree_bridge (spec : SatakeHeckeDegreeSpec) :
    -- 1. GL(n) degree evaluations
    (degGLnT1 2 spec.q = spec.q + 1 ∧
     degGLnT1 3 spec.q = spec.q ^ 2 + spec.q + 1 ∧
     degGLnT1 4 spec.q = spec.q ^ 3 + spec.q ^ 2 + spec.q + 1 ∧
     (spec.q - 1) * degGLnT1 4 spec.q = spec.q ^ 4 - 1) ∧
    -- 2. GL(4) T_2 and q-binomial [4 choose 2]_q
    ((spec.q - 1) * (spec.q ^ 2 - 1) * qBinom4_2 spec.q = (spec.q ^ 4 - 1) * (spec.q ^ 3 - 1) ∧
     degGL4T2 spec.q = spec.q ^ 2 * qBinom4_2 spec.q) ∧
    -- 3. GSp(4) degrees and cross-compatibility
    (gsp4HeckeDegT1 spec.q = degGLnT1 4 spec.q ∧
     gsp4HeckeDegT2 spec.q = spec.q * gsp4HeckeDegT1 spec.q ∧
     0 < gsp4HeckeDegT1 spec.q ∧
     0 < gsp4HeckeDegT2 spec.q) := by
  have hq := spec.hq
  have hqpos : 0 < spec.q := by omega
  have hq1 : 0 < spec.q + 1 := by omega
  have hq2 : 0 < spec.q ^ 2 + 1 := by
    have hqsq : 0 < spec.q * spec.q := Int.mul_pos hqpos hqpos
    have hpow : spec.q ^ 2 = spec.q * spec.q := by
      simp only [Int.pow_succ, Int.pow_zero, Int.one_mul]
    rw [hpow]
    omega
  have hdeg1 : 0 < gsp4HeckeDegT1 spec.q := by
    dsimp [gsp4HeckeDegT1]
    exact Int.mul_pos hq1 hq2
  have hdeg2 : 0 < gsp4HeckeDegT2 spec.q := by
    dsimp [gsp4HeckeDegT2]
    have hp1 : 0 < spec.q * (spec.q + 1) := Int.mul_pos hqpos hq1
    exact Int.mul_pos hp1 hq2
  have hsub1 : (spec.q - 1) * degGLnT1 4 spec.q = spec.q ^ 4 - 1 := by
    rw [degGL4T1_eval]
    have h4 : spec.q ^ 4 = spec.q * spec.q * spec.q * spec.q := by
      simp only [Int.pow_succ, Int.pow_zero, Int.one_mul, Int.mul_assoc]
    have h3 : spec.q ^ 3 = spec.q * spec.q * spec.q := by
      simp only [Int.pow_succ, Int.pow_zero, Int.one_mul, Int.mul_assoc]
    have h2 : spec.q ^ 2 = spec.q * spec.q := by
      simp only [Int.pow_succ, Int.pow_zero, Int.one_mul]
    rw [h4, h3, h2]
    calc (spec.q - 1) * (spec.q * spec.q * spec.q + spec.q * spec.q + spec.q + 1)
      _ = spec.q * (spec.q * spec.q * spec.q + spec.q * spec.q + spec.q + 1) -
            1 * (spec.q * spec.q * spec.q + spec.q * spec.q + spec.q + 1) := by rw [Int.sub_mul]
      _ = (spec.q * (spec.q * spec.q * spec.q) + spec.q * (spec.q * spec.q) +
            spec.q * spec.q + spec.q * 1) -
            (spec.q * spec.q * spec.q + spec.q * spec.q + spec.q + 1) := by
        simp only [Int.mul_add, Int.one_mul]
      _ = spec.q * spec.q * spec.q * spec.q - 1 := by
        simp only [Int.mul_one, Int.mul_assoc]
        omega
  have ht2_fac : gsp4HeckeDegT2 spec.q = spec.q * gsp4HeckeDegT1 spec.q := by
    dsimp [gsp4HeckeDegT1, gsp4HeckeDegT2]
    rw [Int.mul_assoc]
  have hdeg2_gl2 : degGLnT1 2 spec.q = spec.q + 1 := by
    dsimp [degGLnT1, qBinom1]
    simp only [Int.zero_mul, Int.zero_add, Int.one_mul]
  refine ⟨⟨hdeg2_gl2, degGL3T1_eval spec.q, degGL4T1_eval spec.q, hsub1⟩,
          ⟨qBinom4_2_identity spec.q, rfl⟩,
          ⟨gsp4_degT1_eq_gl4_degT1 spec.q, ht2_fac, hdeg1, hdeg2⟩⟩

end SatakeHeckeDegreeBridge

