      rw [hmid_eq]; decide
    have hx_nonneg : 0 ≤ (xIv.lo + xIv.hi).ediv 2 + ((twoPiRaw90.1 + twoPiRaw90.2).ediv 2).ediv 2 := by
      have hlo : 0 ≤ xIv.lo + xIv.hi := Int.add_nonneg hx0 (Int.le_trans hx0 xIv.valid)
      exact Int.add_nonneg (Int.ediv_nonneg hlo (by decide : (0 : Int) ≤ 2))
        (Int.ediv_nonneg (Int.le_of_lt hmid_pos) (by decide : (0 : Int) ≤ 2))
    have hk_nonneg : 0 ≤ ((xIv.lo + xIv.hi).ediv 2 +
