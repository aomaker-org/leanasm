    have hw := hwrap_bound prodIv ((10 ^ 18 + 10) * 3000 + 1) hprod_lo_nonneg hprod_hi_bd hprod_w
    have hw_num : (10 ^ 18 + 10) * 3000 + 1 + 2 * 10 ^ 18 ≤ (4 * 10 ^ 21 : Int) := by decide
    have hw_final : rIv90.hi - rIv90.lo ≤ 4 * 10 ^ 21 := by
      change (reduceModTwoPiCentered90 prodIv).hi - (reduceModTwoPiCentered90 prodIv).lo ≤ 4 * 10 ^ 21
      omega
    have hcum : 512 * (rIv90.hi - rIv90.lo) < 10 ^ 30 := by
      have hm : 512 * (rIv90.hi - rIv90.lo) ≤ 512 * (4 * 10 ^ 21) :=
        Int.mul_le_mul_of_nonneg_left hw_final (by decide)
      have hlt : (512 * (4 * 10 ^ 21) : Int) < 10 ^ 30 := by decide
      omega
    have hr72_w : rIv72.hi - rIv72.lo ≤ 4 * 10 ^ 3 + 2 := by
      dsimp [rIv72, toIv72From90]
      have hdiff_90 : rIv90.hi - rIv90.lo ≤ (4 * 10 ^ 3) * scale18Int := by
        have hc : (4 * 10 ^ 21 : Int) = (4 * 10 ^ 3) * scale18Int := by decide
        omega
      have hspos : 0 < scale18Int := scale18Int_pos
      have h1 : scale18Int * (rIv90.lo.ediv scale18Int) + rIv90.lo.emod scale18Int = rIv90.lo :=
        Int.mul_ediv_add_emod rIv90.lo scale18Int
      have h2 : scale18Int * ((-rIv90.hi).ediv scale18Int) + (-rIv90.hi).emod scale18Int =
          -rIv90.hi :=
        Int.mul_ediv_add_emod (-rIv90.hi) scale18Int
      have hm1 : rIv90.lo.emod scale18Int < scale18Int := Int.emod_lt_of_pos rIv90.lo hspos
      have hm2 : (-rIv90.hi).emod scale18Int < scale18Int := Int.emod_lt_of_pos (-rIv90.hi) hspos
      have hmul : scale18Int * (-((-rIv90.hi).ediv scale18Int) - rIv90.lo.ediv scale18Int) <
          scale18Int * (4 * 10 ^ 3 + 3) := by
        rw [Int.mul_sub, Int.mul_neg]
        have hexp : scale18Int * (4 * 10 ^ 3 + 3 : Int) =
            (4 * 10 ^ 3) * scale18Int + 3 * scale18Int := by decide
        omega
      have hlt : -((-rIv90.hi).ediv scale18Int) - rIv90.lo.ediv scale18Int < 4 * 10 ^ 3 + 3 := by
        apply Int.lt_of_not_ge
        intro hge
        have hbad := Int.mul_le_mul_of_nonneg_left hge (by omega : 0 ≤ scale18Int)
        omega
      omega
    have hms := mulInterval90_sound tPt (lnInterval90_512 n) t90Val lnVal
      ⟨Int.le_refl t90Val, Int.le_refl t90Val⟩ hln
    let p90 : Int := (t90Val * lnVal) / scale90Int
    have hspos : 0 < scale90Int := scale90Int_pos
    have hp_div : p90 * scale90Int ≤ t90Val * lnVal ∧
        t90Val * lnVal < (p90 + 1) * scale90Int := by
      have hdm : scale90Int * p90 + (t90Val * lnVal) % scale90Int = t90Val * lnVal :=
        Int.mul_ediv_add_emod (t90Val * lnVal) scale90Int
      have hmod_ge : 0 ≤ (t90Val * lnVal) % scale90Int :=
        Int.emod_nonneg (t90Val * lnVal) (Int.ne_of_gt hspos)
      have hmod_lt : (t90Val * lnVal) % scale90Int < scale90Int :=
        Int.emod_lt_of_pos (t90Val * lnVal) hspos
      have hc : scale90Int * p90 = p90 * scale90Int := Int.mul_comm _ _
      rw [Int.add_mul, Int.one_mul]
      constructor <;> omega
    have hp_in_prod : prodIv.lo ≤ p90 ∧ p90 ≤ prodIv.hi := by
      have hlo : prodIv.lo ≤ p90 := by
        apply Int.le_of_not_gt
        intro hlt
        have hbad : (p90 + 1) * scale90Int ≤ prodIv.lo * scale90Int :=
          Int.mul_le_mul_of_nonneg_right hlt (Int.le_of_lt hspos)
        have hms1 : prodIv.lo * scale90Int ≤ t90Val * lnVal := hms.2.1
        omega
      have hhi : p90 ≤ prodIv.hi := by
        apply Int.le_of_not_gt
        intro hlt
        have hbad : (prodIv.hi + 1) * scale90Int ≤ p90 * scale90Int :=
          Int.mul_le_mul_of_nonneg_right hlt (Int.le_of_lt hspos)
        have hms2 : t90Val * lnVal ≤ prodIv.hi * scale90Int := hms.2.2
        have hp1 : prodIv.hi * scale90Int < (prodIv.hi + 1) * scale90Int := by
          rw [Int.add_mul, Int.one_mul]; omega
        omega
      exact ⟨hlo, hhi⟩
    obtain ⟨k, hkr1, hkr2⟩ := reduceModTwoPiCentered90_sound prodIv p90 twoPi hp_in_prod htp
    exact ⟨hw_final, hcum, hr72_w, (taylorCosInterval72 rIv72).valid, (taylorSinInterval72 rIv72).valid,
      k, p90, hp_div.1, Int.le_of_lt hp_div.2, hkr1, hkr2⟩

