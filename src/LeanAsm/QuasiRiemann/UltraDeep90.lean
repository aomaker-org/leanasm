namespace QuasiRiemann

/-- Exact equality `PiChudnovsky.intMulBigViaCrtNtt x y = x * y` for all `x y : Int`. -/
theorem intMulBigViaCrtNtt_fn_eq : PiChudnovsky.intMulBigViaCrtNtt = Int.mul :=
  funext fun x => funext fun y => PiChudnovsky.intMulBigViaCrtNtt_eq_mul x y

/-- Scaling constant `10^90` for 90-digit CRT-NTT phase-reduction intervals. -/
def scale90 : Nat := 10 ^ 90

/-- Integer copy of `10^90`. -/
def scale90Int : Int := (scale90 : Int)

/-- Scaling constant `10^84` converting `10^6` grid units into `10^90` scale. -/
def scale84 : Nat := 10 ^ 84

/-- Integer copy of `10^84`. -/
def scale84Int : Int := (scale84 : Int)

/-- Scaling constant `10^18` projecting `10^90` down to `10^72`. -/
def scale18Nat : Nat := 10 ^ 18

/-- Integer copy of `10^18`. -/
def scale18Int : Int := (scale18Nat : Int)

private def scale15Nat : Nat := 10 ^ 15

private theorem scale90Int_pos : (0 : Int) < scale90Int := by decide
private theorem scale18Int_pos : (0 : Int) < scale18Int := by decide
private theorem scale15Nat_pos : 0 < scale15Nat := by decide

/-- Floor division `⌊n / 10^90⌋` via Euclidean division. -/
def floorDiv90 (n : Int) : Int := n.ediv scale90Int

/-- Ceiling division `⌈n / 10^90⌉` via negated Euclidean division. -/
def ceilDiv90 (n : Int) : Int := -((-n).ediv scale90Int)

private theorem floorDiv90_mul_le (n : Int) : floorDiv90 n * scale90Int ≤ n := by
  have h := ediv_mul_le_self n scale90Int scale90Int_pos
  rw [Int.mul_comm] at h
  exact h

private theorem le_ceilDiv90_mul (n : Int) : n ≤ ceilDiv90 n * scale90Int := by
  have h := ediv_mul_le_self (-n) scale90Int scale90Int_pos
  have heq : ceilDiv90 n * scale90Int = -(scale90Int * ((-n).ediv scale90Int)) := by
    dsimp [ceilDiv90]
    rw [Int.neg_mul, Int.mul_comm]
  rw [heq]
  omega

/-- Constructive 90-digit fixed-point closed interval `[lo / 10^90, hi / 10^90]` with `lo ≤ hi`. -/
structure ScaledInterval90 where
  lo : Int
  hi : Int
  valid : lo ≤ hi := by omega

instance : Repr ScaledInterval90 where
  reprPrec iv _ := s!"[{iv.lo}, {iv.hi}]"

instance : DecidableEq ScaledInterval90 := fun a b =>
  if h : a.lo = b.lo ∧ a.hi = b.hi then
    isTrue (by cases a; cases b; simp only at h; cases h.1; cases h.2; rfl)
  else
    isFalse (by intro heq; apply h; cases heq; exact ⟨rfl, rfl⟩)

/-- Zero interval `[0, 0]` at `10^90` scale. -/
def iv90Zero : ScaledInterval90 := ⟨0, 0, by decide⟩

/-- Projects `ScaledInterval90` (`10^90`) conservatively to `ScaledInterval72` (`10^72`). -/
def toIv72From90 (iv : ScaledInterval90) : ScaledInterval72 :=
  ⟨iv.lo.ediv scale18Int, -((-iv.hi).ediv scale18Int),
    floorDiv_le_ceilDiv_gen scale18Int_pos iv.valid⟩

private def toRaw72From90 (r : RawIv72) : RawIv72 :=
  (r.1.ediv scale18Int, -((-r.2).ediv scale18Int))

/-- Outward 90-digit interval multiplication via 4-prime CRT-NTT Karatsuba (`intMulBigViaCrtNtt`). -/
def mulInterval90 (x y : ScaledInterval90) : ScaledInterval90 :=
  let p1 := PiChudnovsky.intMulBigViaCrtNtt x.lo y.lo
  let p2 := PiChudnovsky.intMulBigViaCrtNtt x.lo y.hi
  let p3 := PiChudnovsky.intMulBigViaCrtNtt x.hi y.lo
  let p4 := PiChudnovsky.intMulBigViaCrtNtt x.hi y.hi
  let minP := min (min p1 p2) (min p3 p4)
  let maxP := max (max p1 p2) (max p3 p4)
  ⟨floorDiv90 minP, ceilDiv90 maxP, floorDiv_le_ceilDiv_gen scale90Int_pos (by omega)⟩

/-- Direct integer-multiplication twin of `mulInterval90` for fast kernel checks. -/
def mulInterval90Fast (x y : ScaledInterval90) : ScaledInterval90 :=
  let p1 := x.lo * y.lo
  let p2 := x.lo * y.hi
  let p3 := x.hi * y.lo
  let p4 := x.hi * y.hi
  let minP := min (min p1 p2) (min p3 p4)
  let maxP := max (max p1 p2) (max p3 p4)
  ⟨floorDiv90 minP, ceilDiv90 maxP, floorDiv_le_ceilDiv_gen scale90Int_pos (by omega)⟩

/-- Extensional equality `mulInterval90 = mulInterval90Fast` backed by `intMulBigViaCrtNtt_eq_mul`. -/
theorem mulInterval90_eq_fast (x y : ScaledInterval90) :
    mulInterval90 x y = mulInterval90Fast x y := by
  dsimp [mulInterval90, mulInterval90Fast]
  simp only [PiChudnovsky.intMulBigViaCrtNtt_eq_mul]

/-- Soundness of `mulInterval90` for all real-scaled points `a ∈ x` and `b ∈ y`. -/
theorem mulInterval90_sound (x y : ScaledInterval90) (a b : Int)
    (ha : x.lo ≤ a ∧ a ≤ x.hi) (hb : y.lo ≤ b ∧ b ≤ y.hi) :
    let prod := mulInterval90 x y
    prod.lo ≤ prod.hi ∧ prod.lo * scale90Int ≤ a * b ∧ a * b ≤ prod.hi * scale90Int := by
  intro prod
  refine ⟨prod.valid, ?_⟩
  have hcb := corner_bounds x.lo x.hi y.lo y.hi a b ha hb
  dsimp [prod]
  rw [mulInterval90_eq_fast x y]
  dsimp [mulInterval90Fast]
  have hlo :
      floorDiv90 (min (min (x.lo * y.lo) (x.lo * y.hi)) (min (x.hi * y.lo) (x.hi * y.hi))) *
        scale90Int ≤ a * b :=
    Int.le_trans (floorDiv90_mul_le _) hcb.1
  have hhi : a * b ≤
      ceilDiv90 (max (max (x.lo * y.lo) (x.lo * y.hi)) (max (x.hi * y.lo) (x.hi * y.hi))) *
        scale90Int :=
    Int.le_trans hcb.2 (le_ceilDiv90_mul _)
  exact ⟨hlo, hhi⟩

private def rawInvDen90 (den : Int) : RawIv72 :=
  (scale90Int.ediv den, -((-scale90Int).ediv den))

private def artanhTerms90 (d : Nat) : Nat :=
  if d ≤ 5 then 102 else if d ≤ 20 then 50 else if d ≤ 100 then 34 else 24

private def rawArtanh90 (d : Nat) : RawIv72 :=
  let (_, acc) :=
    foldNatStep (artanhTerms90 d) 0 ((d : Int), (0, 0)) (fun k (p, acc) =>
      let den : Int := (2 * k + 1) * p
      (p * d * d, rawAdd72 acc (rawInvDen90 den)))
  (acc.1, acc.2 + 2)

private def rawToIv90 (r : RawIv72) : ScaledInterval90 :=
  if h : r.1 ≤ r.2 then ⟨r.1, r.2, h⟩ else iv90Zero

private def rawMul90Fast (a b : RawIv72) : RawIv72 :=
  let p1 := a.1 * b.1
  let p2 := a.1 * b.2
  let p3 := a.2 * b.1
  let p4 := a.2 * b.2
  let minP := min (min p1 p2) (min p3 p4)
  let maxP := max (max p1 p2) (max p3 p4)
  (floorDiv90 minP, ceilDiv90 maxP)

private def rawMul90Crt (a b : RawIv72) : RawIv72 :=
  let p1 := PiChudnovsky.intMulBigViaCrtNtt a.1 b.1
  let p2 := PiChudnovsky.intMulBigViaCrtNtt a.1 b.2
  let p3 := PiChudnovsky.intMulBigViaCrtNtt a.2 b.1
  let p4 := PiChudnovsky.intMulBigViaCrtNtt a.2 b.2
  let minP := min (min p1 p2) (min p3 p4)
  let maxP := max (max p1 p2) (max p3 p4)
  (floorDiv90 minP, ceilDiv90 maxP)

private theorem rawMul90_fn_eq : rawMul90Crt = rawMul90Fast := by
  funext a b
  dsimp [rawMul90Crt, rawMul90Fast]
  simp only [PiChudnovsky.intMulBigViaCrtNtt_eq_mul]

private def twoPiRaw90 : RawIv72 :=
  (Int.ofNat (2 * PiChudnovsky.piLower105 / scale15Nat),
   Int.ofNat ((2 * PiChudnovsky.piUpper105 + scale15Nat - 1) / scale15Nat))

