            ((twoPiRaw90.1 + twoPiRaw90.2).ediv 2) := hgt
      have hm1 := Int.mul_le_mul_of_nonneg_right hge (Int.le_of_lt hmid_pos)
      have hm_le := Int.le_trans hm1 hk_mul
      rw [hmid_eq] at hm_le
      have hhalf_tp : ((twoPiRaw90.1 + twoPiRaw90.2).ediv 2).ediv 2 ≤ twoPiLoLit90 := by
        rw [hmid_eq]; decide
      have hthresh : 7 * (10 ^ 18 + 10) * scale90Int + twoPiLoLit90 <
          (2 * 10 ^ 18 + 1) * (twoPiLoLit90 : Int) := by
        decide
