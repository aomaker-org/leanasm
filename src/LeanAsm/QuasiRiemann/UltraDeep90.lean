private def mkHighPrimeEntry90 (t31 : LnPrimeTable72) (p : Nat) : Nat × RawIv72 :=
  let ln6 := rawAdd72 t31.p2 t31.p3
  if p % 6 == 1 then
    (p, rawAdd72 (rawAdd72 ln6 (lnRaw72With t31 ((p - 1) / 6)))
      (rawScaleNat72 2 (rawArtanh90 (2 * p - 1))))
  else
    (p, rawSub72 (rawAdd72 ln6 (lnRaw72With t31 ((p + 1) / 6)))
      (rawScaleNat72 2 (rawArtanh90 (2 * p + 1))))

