  decide +kernel

private def lookupAssoc90 : List (Nat × RawIv72) → Nat → RawIv72
  | [], _ => (0, 0)
  | (k, v) :: rest, target => if k == target then v else lookupAssoc90 rest target

private def lnRaw90_512Aux (t31 : LnPrimeTable72) (hiTbl : List (Nat × RawIv72)) :
    Nat → Nat → RawIv72
  | 0, n => if n ≤ 128 then lnRaw72With t31 n else lookupAssoc90 hiTbl n
  | fuel + 1, n =>
    if n ≤ 128 then
      lnRaw72With t31 n
    else if n % 2 == 0 then rawAdd72 t31.p2 (lnRaw90_512Aux t31 hiTbl fuel (n / 2))
    else if n % 3 == 0 then rawAdd72 t31.p3 (lnRaw90_512Aux t31 hiTbl fuel (n / 3))
    else if n % 5 == 0 then rawAdd72 t31.p5 (lnRaw90_512Aux t31 hiTbl fuel (n / 5))
    else if n % 7 == 0 then rawAdd72 t31.p7 (lnRaw90_512Aux t31 hiTbl fuel (n / 7))
    else if n % 11 == 0 then rawAdd72 t31.p11 (lnRaw90_512Aux t31 hiTbl fuel (n / 11))
    else if n % 13 == 0 then rawAdd72 t31.p13 (lnRaw90_512Aux t31 hiTbl fuel (n / 13))
    else if n % 17 == 0 then rawAdd72 t31.p17 (lnRaw90_512Aux t31 hiTbl fuel (n / 17))
    else if n % 19 == 0 then rawAdd72 t31.p19 (lnRaw90_512Aux t31 hiTbl fuel (n / 19))
    else lookupAssoc90 hiTbl n

private def lnRaw90_512 (t31 : LnPrimeTable72) (hiTbl : List (Nat × RawIv72)) (n : Nat) :
    RawIv72 :=
  lnRaw90_512Aux t31 hiTbl 3 n

/-- Pure rational 90-digit logarithm enclosures `ln(n)` for all `1 ≤ n ≤ 512` via all 97 primes
up to `509` and exact additive prime factorizations. -/
def lnInterval90_512 (n : Nat) : ScaledInterval90 :=
  rawToIv90 (lnRaw90_512 lnPrimeTable90Crt lnHighPrimes90Crt n)

/-- Conservative `72`-digit projection of `ln(n)` for all `1 ≤ n ≤ 512`. -/
def lnInterval72_512 (n : Nat) : ScaledInterval72 :=
  toIv72From90 (lnInterval90_512 n)

private def ln2LoLit90 : Int :=
  693147180559945309417232121458176568075500134360255254120680009493393621969694715605863200

private def ln512Upper90 : Int :=
  6238324625039507784755089093123589112679501209242297287086120085440542597727252440452771000

/-- Constructive validity predicate for `lnInterval90_512 n` across `1 ≤ n ≤ 512`. -/
def ValidLnBound90_512 (n : Nat) (iv : ScaledInterval90) : Prop :=
  iv.lo ≤ iv.hi ∧
  0 ≤ iv.lo ∧
  if n = 1 then
    iv.lo = 0 ∧ iv.hi = 0
  else
    ln2LoLit90 ≤ iv.lo ∧ iv.hi ≤ ln512Upper90 ∧ iv.hi - iv.lo ≤ 3000

instance (n : Nat) (iv : ScaledInterval90) : Decidable (ValidLnBound90_512 n iv) := by
  dsimp [ValidLnBound90_512]
  infer_instance

private def checkLnRangeAux90 (fn : Nat → RawIv72) : Nat → Bool
  | 0 => true
  | k + 1 =>
    let iv := rawToIv90 (fn (k + 1))
    decide (0 ≤ iv.lo ∧ ValidLnBound90_512 (k + 1) iv) && checkLnRangeAux90 fn k

private theorem checkLnRangeAux90_sound (fn : Nat → RawIv72) (m : Nat)
    (h : checkLnRangeAux90 fn m = true) :
    ∀ n, 1 ≤ n → n ≤ m →
      (rawToIv90 (fn n)).lo ≥ 0 ∧ ValidLnBound90_512 n (rawToIv90 (fn n)) := by
  induction m with
  | zero => intro n h1 h0; omega
  | succ k ih =>
    dsimp [checkLnRangeAux90] at h
    have hand : decide (0 ≤ (rawToIv90 (fn (k + 1))).lo ∧
        ValidLnBound90_512 (k + 1) (rawToIv90 (fn (k + 1)))) = true ∧
        checkLnRangeAux90 fn k = true := Bool.and_eq_true _ _ |>.mp h
    intro n h1 hle
    rcases Nat.lt_or_eq_of_le hle with hlt | rfl
    · exact ih hand.2 n h1 (Nat.lt_succ_iff.mp hlt)
    · exact of_decide_eq_true hand.1

/-- Theorem: For every `1 ≤ n ≤ 512`, `lnInterval90_512 n` is non-negative and satisfies
`ValidLnBound90_512` (width `≤ 3000` at `10^90` scale). Zero non-constructive axioms. -/
theorem ln_table_1_to_512_valid :
    ∀ n, 1 ≤ n → n ≤ 512 →
      (lnInterval90_512 n).lo ≥ 0 ∧ ValidLnBound90_512 n (lnInterval90_512 n) := by
  have hok : checkLnRangeAux90 (lnRaw90_512 lnPrimeTable90Lit lnHighPrimes90Lit) 512 = true := by
    decide +kernel
  have h := checkLnRangeAux90_sound (lnRaw90_512 lnPrimeTable90Lit lnHighPrimes90Lit) 512 hok
  dsimp [lnInterval90_512]
  rw [lnPrimeTable90_eq, lnHighPrimes90_eq]
  exact h

private theorem twoPiRaw90Lit_pos : (0 : Int) < (twoPiRaw90Lit.1 + twoPiRaw90Lit.2).ediv 2 := by
  decide

private def reduceModTwoPiRaw90 (xIv : RawIv72) : RawIv72 :=
  reduceModTwoPiRaw72With twoPiRaw90 xIv

/-- Argument reduction modulo `2π` at `10^90` scale centered near `[-π, π]`. -/
def reduceModTwoPiCentered90 (xIv : ScaledInterval90) : ScaledInterval90 :=
  rawToIv90 (reduceModTwoPiRaw90 (xIv.lo, xIv.hi))

/-- Constructive 90-digit modulo-`2π` phase reduction `(t * ln n) mod 2π`, backed by
`mulInterval90` (`intMulBigViaCrtNtt`) and `PiChudnovsky`-derived `twoPiInterval90`. -/
def reducePhaseModTwoPi90 (t90 ln90 : ScaledInterval90) : ScaledInterval90 :=
  reduceModTwoPiCentered90 (mulInterval90 t90 ln90)

/-- Soundness of `reduceModTwoPiCentered90` against `twoPiInterval90`. -/
theorem reduceModTwoPiCentered90_sound (xIv : ScaledInterval90) (x twoPi : Int)
    (hx : xIv.lo ≤ x ∧ x ≤ xIv.hi)
    (htp : twoPiInterval90.lo ≤ twoPi ∧ twoPi ≤ twoPiInterval90.hi) :
    ∃ k : Int,
      (reduceModTwoPiCentered90 xIv).lo ≤ x - k * twoPi ∧
      x - k * twoPi ≤ (reduceModTwoPiCentered90 xIv).hi := by
  have hord_tp : twoPiRaw90.1 ≤ twoPiRaw90.2 := twoPiInterval90_valid
  have hord := reduceModTwoPiRaw72With_ordered twoPiRaw90 (xIv.lo, xIv.hi) hord_tp xIv.valid
  let mid := (xIv.lo + xIv.hi).ediv 2
  let twoPiMid := (twoPiRaw90.1 + twoPiRaw90.2).ediv 2
  let k := (mid + twoPiMid.ediv 2).ediv twoPiMid
  refine ⟨k, ?_⟩
  change (rawToIv90 (reduceModTwoPiRaw72With twoPiRaw90 (xIv.lo, xIv.hi))).lo ≤ x - k * twoPi ∧
    x - k * twoPi ≤ (rawToIv90 (reduceModTwoPiRaw72With twoPiRaw90 (xIv.lo, xIv.hi))).hi
  dsimp [rawToIv90]
  split
  · dsimp [reduceModTwoPiRaw72With]
    change (if 0 ≤ k then (xIv.lo - k * twoPiInterval90.hi, xIv.hi - k * twoPiInterval90.lo)
        else (xIv.lo - k * twoPiInterval90.lo, xIv.hi - k * twoPiInterval90.hi)).1 ≤ x - k * twoPi ∧
      x - k * twoPi ≤
        (if 0 ≤ k then (xIv.lo - k * twoPiInterval90.hi, xIv.hi - k * twoPiInterval90.lo)
        else (xIv.lo - k * twoPiInterval90.lo, xIv.hi - k * twoPiInterval90.hi)).2
    split
    · rename_i hk
      have hm1 : k * twoPi ≤ k * twoPiInterval90.hi := Int.mul_le_mul_of_nonneg_left htp.2 hk
      have hm2 : k * twoPiInterval90.lo ≤ k * twoPi := Int.mul_le_mul_of_nonneg_left htp.1 hk
      constructor <;> omega
    · rename_i hk
      have hnk : 0 ≤ -k := by omega
      have hm1 := Int.mul_le_mul_of_nonneg_left htp.1 hnk
      have hm2 := Int.mul_le_mul_of_nonneg_left htp.2 hnk
      rw [Int.neg_mul, Int.neg_mul] at hm1 hm2
      constructor <;> omega
  · rename_i hneg
    exact absurd hord hneg

private theorem floor_ceil_diff_le_90 (a b M : Int) (_hab : a ≤ b)
    (hdiff : b - a ≤ M * scale90Int) :
    ceilDiv90 b - floorDiv90 a ≤ M + 1 := by
  have hspos : 0 < scale90Int := scale90Int_pos
  have h1 : scale90Int * (a.ediv scale90Int) + a.emod scale90Int = a :=
    Int.mul_ediv_add_emod a scale90Int
  have h2 : scale90Int * ((-b).ediv scale90Int) + (-b).emod scale90Int = -b :=
    Int.mul_ediv_add_emod (-b) scale90Int
  have hm1 : a.emod scale90Int < scale90Int := Int.emod_lt_of_pos a hspos
  have hm2 : (-b).emod scale90Int < scale90Int := Int.emod_lt_of_pos (-b) hspos
  have hf : scale90Int * floorDiv90 a = a - a.emod scale90Int := by
    dsimp [floorDiv90]; omega
  have hc : scale90Int * ceilDiv90 b = b + (-b).emod scale90Int := by
    dsimp [ceilDiv90]; rw [Int.mul_neg]; omega
  have hmul : scale90Int * (ceilDiv90 b - floorDiv90 a) < scale90Int * (M + 2) := by
    rw [Int.mul_sub, hc, hf]
    have hexp : scale90Int * (M + 2) = scale90Int * M + 2 * scale90Int := by
      rw [Int.mul_add]
      have hcomm : scale90Int * 2 = 2 * scale90Int := Int.mul_comm _ _
      omega
    have hmc : scale90Int * M = M * scale90Int := Int.mul_comm _ _
    omega
  have hlt : ceilDiv90 b - floorDiv90 a < M + 2 := by
    apply Int.lt_of_not_ge
    intro hge
    have hbad := Int.mul_le_mul_of_nonneg_left hge (by omega : 0 ≤ scale90Int)
    omega
  omega

set_option exponentiation.threshold 2000 in
/-- Theorem (4-Prime CRT-NTT Phase Reduction & Trig Soundness across `n ≤ 512` at `t ~ 10^12` and
`t ~ 10^18` to strictly `< 10^-60` radians):
1. Couples `PiChudnovsky`'s `10^105` `π` bracket with `twoPiInterval90` (`1`-ULP width at `10^90`).
2. Bounds `2π`-wrapping across `[0, 7 * (10^18 + 10) * scale90]` by at most `2 * 10^18` ULPs at `10^90`.
3. For ALL `1 ≤ n ≤ 512` at BOTH `t ∈ [10^12, 10^12 + 10]` and `t ∈ [10^18, 10^18 + 10]`,
   `reducePhaseModTwoPi90` encloses the exact reduced phase with width `≤ 4 * 10^21` (`4 * 10^-69` rad),
   cumulative 512-term error `512 * width < 10^30` (`< 10^-60` rad!), and projects cleanly to
   `taylorCosInterval72` / `taylorSinInterval72` (`intMul192ViaCrtNtt`). ZERO `Classical.choice`/`sorryAx`. -/
theorem crtNtt_phase_reduction_512_sound :
    (twoPiInterval90.hi - twoPiInterval90.lo = 1 ∧
     twoPiInterval90.lo * 10 ^ 15 ≤ 2 * (PiChudnovsky.piLower105 : Int) ∧
     2 * (PiChudnovsky.piUpper105 : Int) ≤ twoPiInterval90.hi * 10 ^ 15) ∧
    (∀ xIv : ScaledInterval90,
      0 ≤ xIv.lo →
      xIv.hi ≤ 7 * (10 ^ 18 + 10) * scale90Int →
      xIv.hi - xIv.lo ≤ 4 * 10 ^ 21 →
      (reduceModTwoPiCentered90 xIv).hi - (reduceModTwoPiCentered90 xIv).lo ≤ 5 * 10 ^ 21) ∧
    (∀ (t90Val lnVal twoPi : Int) (n : Nat),
      ((10 ^ 12 * scale90Int ≤ t90Val ∧ t90Val ≤ (10 ^ 12 + 10) * scale90Int) ∨
       (10 ^ 18 * scale90Int ≤ t90Val ∧ t90Val ≤ (10 ^ 18 + 10) * scale90Int)) →
      1 ≤ n → n ≤ 512 →
      (lnInterval90_512 n).lo ≤ lnVal ∧ lnVal ≤ (lnInterval90_512 n).hi →
      twoPiInterval90.lo ≤ twoPi ∧ twoPi ≤ twoPiInterval90.hi →
      let rIv90 := reducePhaseModTwoPi90 ⟨t90Val, t90Val, Int.le_refl t90Val⟩ (lnInterval90_512 n)
      let rIv72 := toIv72From90 rIv90
      rIv90.hi - rIv90.lo ≤ 4 * 10 ^ 21 ∧
      512 * (rIv90.hi - rIv90.lo) < 10 ^ 30 ∧
      rIv72.hi - rIv72.lo ≤ 4 * 10 ^ 3 + 2 ∧
      (taylorCosInterval72 rIv72).lo ≤ (taylorCosInterval72 rIv72).hi ∧
      (taylorSinInterval72 rIv72).lo ≤ (taylorSinInterval72 rIv72).hi ∧
      ∃ k p90 : Int,
        p90 * scale90Int ≤ t90Val * lnVal ∧
        t90Val * lnVal ≤ (p90 + 1) * scale90Int ∧
        rIv90.lo ≤ p90 - k * twoPi ∧
        p90 - k * twoPi ≤ rIv90.hi) := by
  have hpi := twoPiInterval90_from_chudnovsky_sound
  have htp_diff : twoPiInterval90.hi - twoPiInterval90.lo = 1 := by
    change twoPiRaw90.2 - twoPiRaw90.1 = 1
    rw [twoPiRaw90_eq]
    decide
  have hwrap_bound :
      ∀ (xIv : ScaledInterval90) (W : Int),
        0 ≤ xIv.lo →
        xIv.hi ≤ 7 * (10 ^ 18 + 10) * scale90Int →
        xIv.hi - xIv.lo ≤ W →
        (reduceModTwoPiCentered90 xIv).hi - (reduceModTwoPiCentered90 xIv).lo ≤
          W + 2 * 10 ^ 18 := by
    intro xIv W hx0 hxhi hxW
    have hord_tp : twoPiRaw90.1 ≤ twoPiRaw90.2 := twoPiInterval90_valid
    have hord := reduceModTwoPiRaw72With_ordered twoPiRaw90 (xIv.lo, xIv.hi) hord_tp xIv.valid
    have hraw_eq : rawToIv90 (reduceModTwoPiRaw72With twoPiRaw90 (xIv.lo, xIv.hi)) =
        ⟨(reduceModTwoPiRaw72With twoPiRaw90 (xIv.lo, xIv.hi)).1,
         (reduceModTwoPiRaw72With twoPiRaw90 (xIv.lo, xIv.hi)).2, hord⟩ := by
      dsimp [rawToIv90]
      split
      · rfl
      · next h => exact absurd hord h
    dsimp [reduceModTwoPiCentered90, reduceModTwoPiRaw90]
    rw [hraw_eq]
    dsimp [reduceModTwoPiRaw72With]
    have hmid_eq : (twoPiRaw90.1 + twoPiRaw90.2).ediv 2 = twoPiLoLit90 := by
      rw [twoPiRaw90_eq]
