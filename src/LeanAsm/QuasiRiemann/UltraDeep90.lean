        (xIv.lo - ((xIv.lo + xIv.hi).ediv 2 +
            ((twoPiRaw90.1 + twoPiRaw90.2).ediv 2).ediv 2).ediv
              ((twoPiRaw90.1 + twoPiRaw90.2).ediv 2) * twoPiRaw90.2,
          xIv.hi - ((xIv.lo + xIv.hi).ediv 2 +
            ((twoPiRaw90.1 + twoPiRaw90.2).ediv 2).ediv 2).ediv
              ((twoPiRaw90.1 + twoPiRaw90.2).ediv 2) * twoPiRaw90.1) := by
      split
      · rfl
      · next h => exact absurd hk_nonneg h
    rw [hite_lo]
    have hk_mul : (((xIv.lo + xIv.hi).ediv 2 + ((twoPiRaw90.1 + twoPiRaw90.2).ediv 2).ediv 2) /
        ((twoPiRaw90.1 + twoPiRaw90.2).ediv 2)) * ((twoPiRaw90.1 + twoPiRaw90.2).ediv 2) ≤
        (xIv.lo + xIv.hi).ediv 2 + ((twoPiRaw90.1 + twoPiRaw90.2).ediv 2).ediv 2 :=
      @Int.ediv_mul_le _ _ (Int.ne_of_gt hmid_pos)
    have hmid_le : (xIv.lo + xIv.hi).ediv 2 ≤ xIv.hi := by
      have hm : ((xIv.lo + xIv.hi) / 2) * 2 ≤ xIv.lo + xIv.hi :=
        @Int.ediv_mul_le (xIv.lo + xIv.hi) 2 (by decide)
