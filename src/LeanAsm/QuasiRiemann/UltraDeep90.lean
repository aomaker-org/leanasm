    have hdiff_res :
        (xIv.hi - ((xIv.lo + xIv.hi).ediv 2 + ((twoPiRaw90.1 + twoPiRaw90.2).ediv 2).ediv 2).ediv
          ((twoPiRaw90.1 + twoPiRaw90.2).ediv 2) * twoPiRaw90.1) -
        (xIv.lo - ((xIv.lo + xIv.hi).ediv 2 + ((twoPiRaw90.1 + twoPiRaw90.2).ediv 2).ediv 2).ediv
