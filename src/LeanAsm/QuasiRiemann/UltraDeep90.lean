      have hmul : t90Val * (lnInterval90_512 n).lo ≤ t90Val * (lnInterval90_512 n).hi :=
        Int.mul_le_mul_of_nonneg_left hln_valid ht0
      change max (max (t90Val * (lnInterval90_512 n).lo) (t90Val * (lnInterval90_512 n).hi))
          (max (t90Val * (lnInterval90_512 n).lo) (t90Val * (lnInterval90_512 n).hi)) = _
      omega
    have hprod_lo_nonneg : 0 ≤ prodIv.lo := by
      rw [hprod_eq]
      dsimp [mulInterval90Fast, floorDiv90]
      rw [hmin_eq]
      exact Int.ediv_nonneg (Int.mul_nonneg ht0 hln_nonneg) (by omega)
    have hprod_hi_bd : prodIv.hi ≤ 7 * (10 ^ 18 + 10) * scale90Int := by
      rw [hprod_eq]
      dsimp [mulInterval90Fast]
      rw [hmax_eq]
      have hm1 : t90Val * (lnInterval90_512 n).hi ≤
          ((10 ^ 18 + 10) * scale90Int) * ln512Upper90 :=
        Int.mul_le_mul ht1 hln_hi_bd (by omega) (by decide)
      have hm2 : ((10 ^ 18 + 10) * scale90Int) * ln512Upper90 ≤
          (7 * (10 ^ 18 + 10) * scale90Int) * scale90Int := by
        decide
      let x90 : Int := t90Val * (lnInterval90_512 n).hi
      let bound90 : Int := (7 * (10 ^ 18 + 10) * scale90Int) * scale90Int
      have hle_mul : x90 ≤ bound90 := Int.le_trans hm1 hm2
      have hceil_lt : scale90Int * ceilDiv90 x90 < bound90 + scale90Int := by
        have hspos : 0 < scale90Int := scale90Int_pos
        have hce : scale90Int * (-x90).ediv scale90Int + (-x90).emod scale90Int = -x90 :=
          Int.mul_ediv_add_emod (-x90) scale90Int
        have hm : (-x90).emod scale90Int < scale90Int := Int.emod_lt_of_pos (-x90) hspos
        have heq_c : scale90Int * ceilDiv90 x90 = x90 + (-x90).emod scale90Int := by
          dsimp [ceilDiv90]; rw [Int.mul_neg]; omega
        rw [heq_c]
        exact Int.add_lt_add_of_le_of_lt hle_mul hm
      apply Int.le_of_not_gt
      intro hgt
      have hge : 7 * (10 ^ 18 + 10) * scale90Int + 1 ≤ ceilDiv90 x90 := hgt
      have hbad := Int.mul_le_mul_of_nonneg_left hge (by omega : 0 ≤ scale90Int)
      have hcm : scale90Int * (7 * (10 ^ 18 + 10) * scale90Int + 1) = bound90 + scale90Int := by
        dsimp [bound90]; rw [Int.mul_comm, Int.add_mul, Int.one_mul]
      have hlt_bad : bound90 + scale90Int < bound90 + scale90Int := by
        calc bound90 + scale90Int = scale90Int * (7 * (10 ^ 18 + 10) * scale90Int + 1) := hcm.symm
          _ ≤ scale90Int * ceilDiv90 x90 := hbad
          _ < bound90 + scale90Int := hceil_lt
      exact (Int.lt_irrefl _) hlt_bad
    have hprod_w : prodIv.hi - prodIv.lo ≤ (10 ^ 18 + 10) * 3000 + 1 := by
      rw [hprod_eq]
      dsimp [mulInterval90Fast]
      rw [hmin_eq, hmax_eq]
      have hdiff_raw : t90Val * (lnInterval90_512 n).hi - t90Val * (lnInterval90_512 n).lo ≤
          ((10 ^ 18 + 10) * 3000) * scale90Int := by
        rw [← Int.mul_sub]
