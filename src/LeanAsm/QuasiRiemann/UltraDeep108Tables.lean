/-- Scaling constant `10^108` for 108-digit CRT-NTT phase-reduction intervals. -/
def scale108 : Nat := 10 ^ 108

/-- Integer copy of `10^108`. -/
def scale108Int : Int := (scale108 : Int)

/-- Internal guard scaling constant `10^110` for 108-digit prime log synthesis. -/
def scale110Int : Int := (10 ^ 110 : Int)

set_option exponentiation.threshold 2000 in
/-- Scaling constant `10^102` converting `10^6` grid units into `10^108` scale. -/
def scale102 : Nat := 10 ^ 102

/-- Integer copy of `10^102`. -/
def scale102Int : Int := (scale102 : Int)

set_option exponentiation.threshold 2000 in
def scale90To18Int : Int := (10 ^ 90 : Int)

private theorem scale108Int_pos : (0 : Int) < scale108Int := by decide

/-- Floor division `⌊n / 10^108⌋` via Euclidean division. -/
def floorDiv108 (n : Int) : Int := n.ediv scale108Int

/-- Ceiling division `⌈n / 10^108⌉` via negated Euclidean division. -/
def ceilDiv108 (n : Int) : Int := -((-n).ediv scale108Int)

private theorem floorDiv108_mul_le (n : Int) : floorDiv108 n * scale108Int ≤ n := by
  have h := ediv_mul_le_self n scale108Int scale108Int_pos
  rw [Int.mul_comm] at h
  exact h

private theorem le_ceilDiv108_mul (n : Int) : n ≤ ceilDiv108 n * scale108Int := by
  have h := ediv_mul_le_self (-n) scale108Int scale108Int_pos
  have heq : ceilDiv108 n * scale108Int = -(scale108Int * ((-n).ediv scale108Int)) := by
    dsimp [ceilDiv108]
    rw [Int.neg_mul, Int.mul_comm]
  rw [heq]
  omega

/-- Verified `10^108`-scaled interval `[lo, hi]` with `lo ≤ hi`. -/
structure ScaledInterval108 where
  lo : Int
  hi : Int
  valid : lo ≤ hi
  deriving DecidableEq, Repr

private def iv108Zero : ScaledInterval108 := ⟨0, 0, Int.le_refl 0⟩

/-- Outward 108-digit interval multiplication via `intMulBigViaCrtNtt`. -/
def mulInterval108 (x y : ScaledInterval108) : ScaledInterval108 :=
  let p1 := PiChudnovsky.intMulBigViaCrtNtt x.lo y.lo
  let p2 := PiChudnovsky.intMulBigViaCrtNtt x.lo y.hi
  let p3 := PiChudnovsky.intMulBigViaCrtNtt x.hi y.lo
  let p4 := PiChudnovsky.intMulBigViaCrtNtt x.hi y.hi
  let minP := min (min p1 p2) (min p3 p4)
  let maxP := max (max p1 p2) (max p3 p4)
  ⟨floorDiv108 minP, ceilDiv108 maxP, floorDiv_le_ceilDiv_gen scale108Int_pos (by omega)⟩

/-- Direct integer-multiplication twin of `mulInterval108` for fast kernel checks. -/
def mulInterval108Fast (x y : ScaledInterval108) : ScaledInterval108 :=
  let p1 := x.lo * y.lo
  let p2 := x.lo * y.hi
  let p3 := x.hi * y.lo
  let p4 := x.hi * y.hi
  let minP := min (min p1 p2) (min p3 p4)
  let maxP := max (max p1 p2) (max p3 p4)
  ⟨floorDiv108 minP, ceilDiv108 maxP, floorDiv_le_ceilDiv_gen scale108Int_pos (by omega)⟩

/-- Extensional equality `mulInterval108 = mulInterval108Fast`. -/
theorem mulInterval108_eq_fast (x y : ScaledInterval108) :
    mulInterval108 x y = mulInterval108Fast x y := by
  dsimp [mulInterval108, mulInterval108Fast]
  simp only [PiChudnovsky.intMulBigViaCrtNtt_eq_mul]

/-- Soundness of `mulInterval108` for all real-scaled points `a ∈ x` and `b ∈ y`. -/
theorem mulInterval108_sound (x y : ScaledInterval108) (a b : Int)
    (ha : x.lo ≤ a ∧ a ≤ x.hi) (hb : y.lo ≤ b ∧ b ≤ y.hi) :
    let prod := mulInterval108 x y
    prod.lo ≤ prod.hi ∧ prod.lo * scale108Int ≤ a * b ∧ a * b ≤ prod.hi * scale108Int := by
  intro prod
  refine ⟨prod.valid, ?_⟩
  have hcb := corner_bounds x.lo x.hi y.lo y.hi a b ha hb
  dsimp [prod]
  rw [mulInterval108_eq_fast x y]
  dsimp [mulInterval108Fast]
  have hlo :
      floorDiv108 (min (min (x.lo * y.lo) (x.lo * y.hi)) (min (x.hi * y.lo) (x.hi * y.hi))) *
        scale108Int ≤ a * b :=
    Int.le_trans (floorDiv108_mul_le _) hcb.1
  have hhi : a * b ≤
      ceilDiv108 (max (max (x.lo * y.lo) (x.lo * y.hi)) (max (x.hi * y.lo) (x.hi * y.hi))) *
        scale108Int :=
    Int.le_trans hcb.2 (le_ceilDiv108_mul _)
  exact ⟨hlo, hhi⟩

private def rawInvDen110 (den : Int) : RawIv72 :=
  (scale110Int.ediv den, -((-scale110Int).ediv den))

private def artanhTerms110 (d : Nat) : Nat :=
  if d ≤ 3 then 124
  else if d ≤ 5 then 85
  else if d ≤ 9 then 62
  else if d ≤ 20 then 58
  else if d ≤ 50 then 48
  else if d ≤ 100 then 38
  else if d ≤ 400 then 30
  else 25

private def rawArtanh110 (d : Nat) : RawIv72 :=
  let (_, acc) :=
    foldNatStep (artanhTerms110 d) 0 ((d : Int), (0, 0)) (fun k (p, acc) =>
      let den : Int := (2 * k + 1) * p
      (p * d * d, rawAdd72 acc (rawInvDen110 den)))
  (acc.1, acc.2 + 2)

private def proj110To108 (iv : RawIv72) : RawIv72 :=
