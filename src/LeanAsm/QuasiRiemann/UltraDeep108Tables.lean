private def splitListMid108Aux : Nat → List (Nat × RawIv72) →
    List (Nat × RawIv72) × List (Nat × RawIv72)
  | 0, xs => ([], xs)
  | _ + 1, [] => ([], [])
  | k + 1, x :: xs =>
    let (l, r) := splitListMid108Aux k xs
    (x :: l, r)

private def listToPrimeTree108 (fuel : Nat) (xs : List (Nat × RawIv72)) : PrimeTree108 :=
  match fuel, xs with
  | 0, _ => .empty
  | _, [] => .empty
  | f + 1, _ =>
    let (l, mr) := splitListMid108Aux (xs.length / 2) xs
    match mr with
    | [] => .empty
    | (p, iv) :: r => .branch p iv (listToPrimeTree108 f l) (listToPrimeTree108 f r)

private def buildPrimeTree108From110 (xs110 : List (Nat × RawIv72)) : PrimeTree108 :=
  listToPrimeTree108 16 (xs110.map (fun (p, iv) => (p, proj110To108 iv)))

