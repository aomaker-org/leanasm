private def mkHighPrimeEntry110 (t31 : LnPrimeTable72) (acc : List (Nat × RawIv72))
    (p : Nat) : Nat × RawIv72 :=
  let (rem, accLn) := stripSmallPrimes108Aux t31 (p - 1)
  let prevLn := if rem ≤ 1 then accLn else rawAdd72 accLn (lookupAssoc110 acc rem)
  (p, rawAdd72 prevLn (rawScaleNat72 2 (rawArtanh110 (2 * p - 1))))

private def buildHighPrimes110Slice (t31 : LnPrimeTable72) (init : List (Nat × RawIv72))
    (ps : List Nat) : List (Nat × RawIv72) :=
  (ps.foldl (fun (tbl, out) p =>
    let e := mkHighPrimeEntry110 t31 tbl p
    (tbl ++ [e], out ++ [e])) (init, [])).2

