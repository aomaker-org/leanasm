/-- Balanced binary search tree for fast `O(log N)` prime log lookup (`128 < p ≤ 2048`). -/
inductive PrimeTree108
  | empty
  | branch (p : Nat) (iv : RawIv72) (l r : PrimeTree108)
  deriving DecidableEq, Repr

def lookupPrimeTree108 (t : PrimeTree108) (q : Nat) : RawIv72 :=
  match t with
  | .empty => (0, 0)
  | .branch p iv l r =>
    if q < p then lookupPrimeTree108 l q
    else if p < q then lookupPrimeTree108 r q
    else iv

def stripSmallPrimes108Aux (t31 : LnPrimeTable72) (n : Nat) : Nat × RawIv72 :=
  let (m, acc) := (n, (0, 0))
  let (m, acc) := foldNatStep 12 m (m, acc) (fun _ (k, a) =>
    if k % 2 == 0 then (k / 2, rawAdd72 a t31.p2) else (k, a))
  let (m, acc) := foldNatStep 7 m (m, acc) (fun _ (k, a) =>
    if k % 3 == 0 then (k / 3, rawAdd72 a t31.p3) else (k, a))
  let (m, acc) := foldNatStep 5 m (m, acc) (fun _ (k, a) =>
    if k % 5 == 0 then (k / 5, rawAdd72 a t31.p5) else (k, a))
  let (m, acc) := foldNatStep 4 m (m, acc) (fun _ (k, a) =>
    if k % 7 == 0 then (k / 7, rawAdd72 a t31.p7) else (k, a))
  let (m, acc) := foldNatStep 4 m (m, acc) (fun _ (k, a) =>
    if k % 11 == 0 then (k / 11, rawAdd72 a t31.p11) else (k, a))
  let (m, acc) := foldNatStep 3 m (m, acc) (fun _ (k, a) =>
    if k % 13 == 0 then (k / 13, rawAdd72 a t31.p13) else (k, a))
  let (m, acc) := foldNatStep 3 m (m, acc) (fun _ (k, a) =>
    if k % 17 == 0 then (k / 17, rawAdd72 a t31.p17) else (k, a))
  let (m, acc) := foldNatStep 3 m (m, acc) (fun _ (k, a) =>
    if k % 19 == 0 then (k / 19, rawAdd72 a t31.p19) else (k, a))
  let (m, acc) := foldNatStep 3 m (m, acc) (fun _ (k, a) =>
    if k % 23 == 0 then (k / 23, rawAdd72 a t31.p23) else (k, a))
  let (m, acc) := foldNatStep 3 m (m, acc) (fun _ (k, a) =>
    if k % 29 == 0 then (k / 29, rawAdd72 a t31.p29) else (k, a))
  let (m, acc) := foldNatStep 3 m (m, acc) (fun _ (k, a) =>
    if k % 31 == 0 then (k / 31, rawAdd72 a t31.p31) else (k, a))
  let (m, acc) := foldNatStep 3 m (m, acc) (fun _ (k, a) =>
    if k % 37 == 0 then (k / 37, rawAdd72 a t31.p37) else (k, a))
  let (m, acc) := foldNatStep 3 m (m, acc) (fun _ (k, a) =>
    if k % 41 == 0 then (k / 41, rawAdd72 a t31.p41) else (k, a))
  let (m, acc) := foldNatStep 3 m (m, acc) (fun _ (k, a) =>
    if k % 43 == 0 then (k / 43, rawAdd72 a t31.p43) else (k, a))
  let (m, acc) := if m % 47 == 0 then (m / 47, rawAdd72 acc t31.p47) else (m, acc)
  let (m, acc) := if m % 53 == 0 then (m / 53, rawAdd72 acc t31.p53) else (m, acc)
  let (m, acc) := if m % 59 == 0 then (m / 59, rawAdd72 acc t31.p59) else (m, acc)
