def lnRaw108_2048 (t31 : LnPrimeTable72) (hiTree : PrimeTree108) (n : Nat) : RawIv72 :=
  if n ≤ 1 then (0, 0)
  else
    let (rem, acc) := stripSmallPrimes108Aux t31 n
    if rem ≤ 1 then acc else rawAdd72 acc (lookupPrimeTree108 hiTree rem)

