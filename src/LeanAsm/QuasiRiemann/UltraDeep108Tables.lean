def rawToIv108 (r : RawIv72) : ScaledInterval108 :=
  if h : r.1 ≤ r.2 then ⟨r.1, r.2, h⟩ else iv108Zero

def rawMul108Fast (a b : RawIv72) : RawIv72 :=
  let p1 := a.1 * b.1
  let p2 := a.1 * b.2
  let p3 := a.2 * b.1
  let p4 := a.2 * b.2
  let minP := min (min p1 p2) (min p3 p4)
  let maxP := max (max p1 p2) (max p3 p4)
  (floorDiv108 minP, ceilDiv108 maxP)

def rawMul108Crt (a b : RawIv72) : RawIv72 :=
  let p1 := PiChudnovsky.intMulBigViaCrtNtt a.1 b.1
  let p2 := PiChudnovsky.intMulBigViaCrtNtt a.1 b.2
  let p3 := PiChudnovsky.intMulBigViaCrtNtt a.2 b.1
  let p4 := PiChudnovsky.intMulBigViaCrtNtt a.2 b.2
  let minP := min (min p1 p2) (min p3 p4)
  let maxP := max (max p1 p2) (max p3 p4)
  (floorDiv108 minP, ceilDiv108 maxP)

theorem rawMul108_fn_eq : rawMul108Crt = rawMul108Fast := by
  funext a b
  dsimp [rawMul108Crt, rawMul108Fast]
  simp only [PiChudnovsky.intMulBigViaCrtNtt_eq_mul]

