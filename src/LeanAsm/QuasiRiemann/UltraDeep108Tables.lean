/-- Certified `10^108`-scaled natural logarithm interval for any integer `1 ≤ n ≤ 2048`. -/
def lnInterval108_2048 (n : Nat) : ScaledInterval108 :=
  rawToIv108 (lnRaw108_2048 lnPrimeTable108Crt lnHighPrimes108TreeCrt n)

private def ln2LoLit108 : Int :=
  693147180559945309417232121458176568075500134360255254120680009493393621969694715605863326996418687542001479
private def ln2048Upper108 : Int :=
  7624618986159398403589553336039942248830501477962807795327480104427329841666641871664496596960605562962016413

/-- Constructive validity predicate for `lnInterval108_2048 n` across `1 ≤ n ≤ 2048`. -/
def ValidLnBound108_2048 (n : Nat) (iv : ScaledInterval108) : Prop :=
  iv.lo ≤ iv.hi ∧
  0 ≤ iv.lo ∧
  if n = 1 then
    iv.lo = 0 ∧ iv.hi = 0
  else
    ln2LoLit108 ≤ iv.lo ∧ iv.hi ≤ ln2048Upper108 ∧ iv.hi - iv.lo ≤ 50

instance (n : Nat) (iv : ScaledInterval108) : Decidable (ValidLnBound108_2048 n iv) := by
  dsimp [ValidLnBound108_2048]
  infer_instance

private def checkLnRangeSpan108 (fn : Nat → RawIv72) (base count : Nat) : Bool :=
  match count with
  | 0 => true
  | k + 1 =>
    let n := base + k
    let iv := rawToIv108 (fn n)
    decide (0 ≤ iv.lo ∧ ValidLnBound108_2048 n iv) && checkLnRangeSpan108 fn base k

private theorem checkLnRangeSpan108_sound (fn : Nat → RawIv72) (base count : Nat)
    (h : checkLnRangeSpan108 fn base count = true) :
    ∀ n, base ≤ n → n < base + count →
      (rawToIv108 (fn n)).lo ≥ 0 ∧ ValidLnBound108_2048 n (rawToIv108 (fn n)) := by
  induction count with
  | zero => intro n hn1 hn2; omega
  | succ k ih =>
    dsimp [checkLnRangeSpan108] at h
    have hand : decide (0 ≤ (rawToIv108 (fn (base + k))).lo ∧
        ValidLnBound108_2048 (base + k) (rawToIv108 (fn (base + k)))) = true ∧
        checkLnRangeSpan108 fn base k = true := Bool.and_eq_true _ _ |>.mp h
    intro n hn1 hn2
    rcases Nat.lt_or_eq_of_le (Nat.lt_succ_iff.mp hn2) with hlt | rfl
    · exact ih hand.2 n hn1 hlt
    · exact of_decide_eq_true hand.1

private theorem ln_1_to_512_ok :
    checkLnRangeSpan108 (lnRaw108_2048 lnPrimeTable108Lit lnHighPrimes108TreeLit) 1 512 = true := by
  decide +kernel
private theorem ln_513_to_1024_ok :
    checkLnRangeSpan108 (lnRaw108_2048 lnPrimeTable108Lit lnHighPrimes108TreeLit) 513 512 = true := by
  decide +kernel
private theorem ln_1025_to_1536_ok :
    checkLnRangeSpan108 (lnRaw108_2048 lnPrimeTable108Lit lnHighPrimes108TreeLit) 1025 512 = true := by
  decide +kernel
private theorem ln_1537_to_2048_ok :
    checkLnRangeSpan108 (lnRaw108_2048 lnPrimeTable108Lit lnHighPrimes108TreeLit) 1537 512 = true := by
  decide +kernel

/-- Theorem: For every `1 ≤ n ≤ 2048`, `lnInterval108_2048 n` is non-negative and satisfies
`ValidLnBound108_2048` (width `≤ 50` at `10^108` scale). Zero non-constructive axioms. -/
theorem ln_table_1_to_2048_valid :
    ∀ n, 1 ≤ n → n ≤ 2048 →
      (lnInterval108_2048 n).lo ≥ 0 ∧ ValidLnBound108_2048 n (lnInterval108_2048 n) := by
  have h1 := checkLnRangeSpan108_sound
    (lnRaw108_2048 lnPrimeTable108Lit lnHighPrimes108TreeLit) 1 512 ln_1_to_512_ok
  have h2 := checkLnRangeSpan108_sound
    (lnRaw108_2048 lnPrimeTable108Lit lnHighPrimes108TreeLit) 513 512 ln_513_to_1024_ok
  have h3 := checkLnRangeSpan108_sound
    (lnRaw108_2048 lnPrimeTable108Lit lnHighPrimes108TreeLit) 1025 512 ln_1025_to_1536_ok
  have h4 := checkLnRangeSpan108_sound
    (lnRaw108_2048 lnPrimeTable108Lit lnHighPrimes108TreeLit) 1537 512 ln_1537_to_2048_ok
  intro n hn1 hn2048
  dsimp [lnInterval108_2048]
  rw [lnPrimeTable108_eq, lnHighPrimes108Tree_eq]
  cases Nat.decLe n 512 with
  | isTrue ha => exact h1 n hn1 (Nat.lt_succ_of_le ha)
  | isFalse ha =>
    cases Nat.decLe n 1024 with
    | isTrue hb => exact h2 n (by omega) (Nat.lt_succ_of_le hb)
    | isFalse hb =>
      cases Nat.decLe n 1536 with
      | isTrue hc => exact h3 n (by omega) (Nat.lt_succ_of_le hc)
      | isFalse hc => exact h4 n (by omega) (by omega)

private def reduceModTwoPiRaw108 (xIv : RawIv72) : RawIv72 :=
  reduceModTwoPiRaw72With twoPiRaw108 xIv

/-- Argument reduction modulo `2π` at `10^108` scale centered near `[-π, π]`. -/
def reduceModTwoPiCentered108 (xIv : ScaledInterval108) : ScaledInterval108 :=
  rawToIv108 (reduceModTwoPiRaw108 (xIv.lo, xIv.hi))

/-- Constructive 108-digit modulo-`2π` phase reduction `(t * ln n) mod 2π`, backed by
`mulInterval108` (`intMulBigViaCrtNtt`) and `PiChudnovsky`-derived `twoPiInterval108`. -/
def reducePhaseModTwoPi108 (t108 ln108 : ScaledInterval108) : ScaledInterval108 :=
  reduceModTwoPiCentered108 (mulInterval108 t108 ln108)

private theorem rawToIv108_of_le (r : RawIv72) (h : r.1 ≤ r.2) :
    rawToIv108 r = ⟨r.1, r.2, h⟩ := by
  dsimp [rawToIv108]
  exact dite_eq_left h

private theorem reduceModTwoPiRaw72With_sound (tp : RawIv72) (xIv : ScaledInterval108)
    (x twoPi : Int) (hx : xIv.lo ≤ x ∧ x ≤ xIv.hi) (htp : tp.1 ≤ twoPi ∧ twoPi ≤ tp.2) :
    let res := reduceModTwoPiRaw72With tp (xIv.lo, xIv.hi)
    let k := ((xIv.lo + xIv.hi).ediv 2 + ((tp.1 + tp.2).ediv 2).ediv 2).ediv
      ((tp.1 + tp.2).ediv 2)
    res.1 ≤ x - k * twoPi ∧ x - k * twoPi ≤ res.2 := by
  dsimp [reduceModTwoPiRaw72With]
  cases Int.decLe 0 (((xIv.lo + xIv.hi).ediv 2 + ((tp.1 + tp.2).ediv 2).ediv 2).ediv
      ((tp.1 + tp.2).ediv 2)) with
  | isTrue hk =>
    simp only [hk, ↓reduceIte]
    have hlo := Int.mul_le_mul_of_nonneg_left htp.2 hk
    have hhi := Int.mul_le_mul_of_nonneg_left htp.1 hk
    exact ⟨Int.sub_le_sub hx.1 hlo, Int.sub_le_sub hx.2 hhi⟩
  | isFalse hk =>
    simp only [hk, ↓reduceIte]
    have hkne : ((xIv.lo + xIv.hi).ediv 2 + ((tp.1 + tp.2).ediv 2).ediv 2).ediv
        ((tp.1 + tp.2).ediv 2) ≤ 0 := Int.le_of_not_gt (fun hgt => hk (Int.le_of_lt hgt))
    have hlo := Int.mul_le_mul_of_nonpos_left hkne htp.1
    have hhi := Int.mul_le_mul_of_nonpos_left hkne htp.2
    exact ⟨Int.sub_le_sub hx.1 hlo, Int.sub_le_sub hx.2 hhi⟩

/-- Soundness of `reduceModTwoPiCentered108` against `twoPiInterval108`. -/
theorem reduceModTwoPiCentered108_sound (xIv : ScaledInterval108) (x twoPi : Int)
    (hx : xIv.lo ≤ x ∧ x ≤ xIv.hi)
    (htp : twoPiInterval108.lo ≤ twoPi ∧ twoPi ≤ twoPiInterval108.hi) :
    ∃ k : Int,
      (reduceModTwoPiCentered108 xIv).lo ≤ x - k * twoPi ∧
      x - k * twoPi ≤ (reduceModTwoPiCentered108 xIv).hi := by
  rw [twoPiInterval108_lo_eq, twoPiInterval108_hi_eq] at htp
  have hord_tp : twoPiRaw108.1 ≤ twoPiRaw108.2 := twoPiInterval108_valid
  have hord := reduceModTwoPiRaw72With_ordered twoPiRaw108 (xIv.lo, xIv.hi) hord_tp xIv.valid
  have hraw := rawToIv108_of_le (reduceModTwoPiRaw72With twoPiRaw108 (xIv.lo, xIv.hi)) hord
  dsimp only [reduceModTwoPiCentered108, reduceModTwoPiRaw108]
  rw [hraw]
  exact ⟨_, reduceModTwoPiRaw72With_sound twoPiRaw108 xIv x twoPi hx htp⟩

/-- Converts `ScaledInterval108` (`10^108`) conservatively to `RawIv72` (`10^18`). -/
def rawTo18From108 (iv : RawIv72) : RawIv72 :=
  (iv.1.ediv scale90To18Int, -((-iv.2).ediv scale90To18Int))

private theorem ediv_mul_gt_sub (n d : Int) (hd : 0 < d) :
    n - d + 1 ≤ d * (n.ediv d) := by
  have h1 : d * n.ediv d + n.emod d = n := Int.mul_ediv_add_emod n d
  have h2 : n.emod d < d := Int.emod_lt_of_pos n hd
  omega

private theorem ceilDiv108_mul_le_add (n : Int) :
    ceilDiv108 n * scale108Int ≤ n + scale108Int - 1 := by
  have h := ediv_mul_gt_sub (-n) scale108Int scale108Int_pos
  have heq : ceilDiv108 n * scale108Int = -(scale108Int * ((-n).ediv scale108Int)) := by
    dsimp [ceilDiv108]
    rw [Int.neg_mul, Int.mul_comm]
  rw [heq]
  omega

private theorem to72_width_of_108_width (rIv108 : ScaledInterval108) (W : Int) (_hW : 0 ≤ W)
    (hw : rIv108.hi - rIv108.lo ≤ W * scale90To18Int) :
    let rLo18 := rIv108.lo.ediv scale90To18Int
    let rHi18 := -((-rIv108.hi).ediv scale90To18Int)
    rHi18 - rLo18 ≤ W + 2 := by
  have hspos : (0 : Int) < scale90To18Int := by decide
  intro rLo18 rHi18
  have hlo : rIv108.lo - scale90To18Int + 1 ≤ rLo18 * scale90To18Int := by
    have h := ediv_mul_gt_sub rIv108.lo scale90To18Int hspos
    rw [Int.mul_comm] at h; exact h
  have hhi : rHi18 * scale90To18Int ≤ rIv108.hi + scale90To18Int - 1 := by
    have h := ediv_mul_gt_sub (-rIv108.hi) scale90To18Int hspos
    have hneg : rHi18 * scale90To18Int = -(scale90To18Int * ((-rIv108.hi).ediv scale90To18Int)) := by
      dsimp [rHi18]; rw [Int.neg_mul, Int.mul_comm]
    rw [hneg]; omega
  have hdiff : (rHi18 - rLo18) * scale90To18Int ≤ (rIv108.hi - rIv108.lo) + 2 * scale90To18Int := by
    rw [Int.sub_mul]; omega
  have hdiff2 : (rHi18 - rLo18) * scale90To18Int ≤ (W + 2) * scale90To18Int := by
    rw [Int.add_mul]; omega
  apply Int.le_of_not_gt
  intro hgt
  have hge : W + 3 ≤ rHi18 - rLo18 := by omega
  have hm := Int.mul_le_mul_of_nonneg_right hge (Int.le_of_lt hspos)
  have hlhs : (W + 2) * scale90To18Int < (W + 3) * scale90To18Int := by
    rw [Int.add_mul, Int.add_mul]; omega
  omega

