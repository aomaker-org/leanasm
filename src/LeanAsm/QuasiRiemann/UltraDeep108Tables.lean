  let (m, acc) := if m % 97 == 0 then (m / 97, rawAdd72 acc t31.p97) else (m, acc)
  let (m, acc) := if m % 101 == 0 then (m / 101, rawAdd72 acc t31.p101) else (m, acc)
  let (m, acc) := if m % 103 == 0 then (m / 103, rawAdd72 acc t31.p103) else (m, acc)
