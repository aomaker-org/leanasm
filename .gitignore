# Path: leanasm/.gitignore
# Git ignore rules for leanasm workspace

# Lean / Lake build artifacts
/.lake/
lake-packages/
*.olean
*.ilean
*.c
*.o

# Byte-compiled / Python artifacts
__pycache__/
*.py[cod]
*$py.class
.venv/
.venv*/
.pytest_cache/

# Logs and transient traces
logs/tasks/*.log
logs/tasks/*.jsonl
logs/traces/
!logs/tasks/.gitkeep

# Editor & OS temporary files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# end of file: leanasm/.gitignore
subrepos/
